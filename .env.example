# =====================================================================
# Date Palm Health Monitoring System — Environment Configuration
#
# Copy this file to .env and fill in real values:
#     cp .env.example .env
#
# NEVER commit the real .env file to version control (it is git-ignored).
# =====================================================================

# ------------------------- Application -------------------------------
APP_NAME="Date Palm Health Monitor"
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ------------------------- HTTP server -------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=1
# Comma-separated list of allowed CORS origins (Streamlit dashboard, etc.)
# NOTE: list fields must be JSON-formatted in .env (pydantic-settings parses JSON)
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# ------------------------- Database (PostgreSQL) ---------------------
POSTGRES_USER=palm_admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=palm_monitor
# Optional: full DSN overrides the individual POSTGRES_* variables above
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/palm_monitor
DB_ECHO_LOG=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------- Security ----------------------------------
# Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-only-secret-key-change-in-production-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------- AI inference ------------------------------
# glm       -> GLM-4V vision-language API (recommended default)
# local_cnn -> locally trained MobileNetV2 weights in ml/models/
VISION_PROVIDER=glm
GLM_API_KEY=your-glm-api-key-here
GLM_API_BASE=https://api.z.ai/api/paas/v4
GLM_VISION_MODEL=glm-4v-plus
INFERENCE_TIMEOUT_SECONDS=60
CONFIDENCE_THRESHOLD=0.60
MODEL_WEIGHTS_PATH=ml/models/mobilenetv2_palm_best.pt

# ------------------------- File storage ------------------------------
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# ------------------------- Frontend (Streamlit) ----------------------
# Read directly by the Streamlit dashboard (Step 5); ignored by the API.
STREAMLIT_API_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501
